# --- Supabase (Project Settings > API) -------------------------------------------------------
# src/lib/supabase.ts reads the PUBLISHABLE key (the older "anon" key also works).
NEXT_PUBLIC_SUPABASE_URL=https://japmoslubzchwlbrsels.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_edpbi7PMRAPvScllpz_YKQ_GtsEtWuA

# demo = simulated data in memory (no Supabase needed); supabase = real database.
# Leave this unset for the cloud: it defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set.
# VYRA_DATA_MODE=demo

# --- Optional, server only: lets an administrator create accounts that are confirmed straight away ---
# Supabase > Project Settings > API Keys > secret / service_role key. NEVER prefix it with NEXT_PUBLIC_,
# never commit it, and set it in Vercel as an ordinary (non-public) environment variable.
# Without it, the Accounts page still works through ordinary sign-up (subject to "Confirm email").
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Only for `npm run db:setup` / `npm run db:seed` (never commit this file's real values) ---
# Supabase > Connect > Session pooler. URL-encode special characters in the password (@ becomes %40).
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Password given to ALL seeded demo accounts (admin, responders, citizens). Default: VYRA-demo-1.
# Set your own for any project other people can reach. 6+ characters, no "$$".
# SEED_PASSWORD=choose-something-long-and-unique
